{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aleafpath-travel",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/css/*",
      "!/fonts/*",
      "!/favicon.png"
    ]
  },

  "vars": {
    "SUPABASE_ANON_KEY": "sb_publishable__8VdnjBQYgeFtPdArs4lww_4RJxrDye",
    "SUPABASE_URL": "https://rpzqioezweftrjtrneos.supabase.co"
  }

  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
